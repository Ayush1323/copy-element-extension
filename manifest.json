{
  "manifest_version": 3,
  "name": "LinkLens",
  "short_name": "LinkLens",
  "version": "1.0.0",
  "description": "Hover links to instantly reveal destinations and HTML attributes, then copy what you need. Hover. Discover. Copy.",
  "minimum_chrome_version": "111",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "LinkLens",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "clipboardWrite",
    "declarativeNetRequestWithHostAccess"
  ],
  "host_permissions": [
    "https://web.archive.org/*"
  ],
  "commands": {
    "activate-element-picker": {
      "suggested_key": {
        "default": "Alt+E",
        "mac": "Alt+E"
      },
      "description": "Activate Element Picker"
    },
    "copy-hovered": {
      "suggested_key": {
        "default": "Alt+C",
        "mac": "Alt+C"
      },
      "description": "Copy hovered element"
    },
    "activate-section-picker": {
      "suggested_key": {
        "default": "Alt+S",
        "mac": "Alt+S"
      },
      "description": "Activate Section Extractor"
    },
    "capture-screenshot": {
      "suggested_key": {
        "default": "Alt+Shift+S",
        "mac": "Alt+Shift+S"
      },
      "description": "Capture a screenshot of this page"
    },
    "activate-text-utils": {
      "description": "Open Text Utils"
    },
    "activate-seo": {
      "description": "Open the SEO Analyzer"
    },
    "activate-authority": {
      "description": "Open Domain Authority"
    },
    "activate-images": {
      "description": "Inspect images, fonts and colours"
    },
    "activate-measure": {
      "description": "Measure sizes, spacing and gaps (Dimensions)"
    },
    "activate-card-extractor": {
      "description": "Activate Card Extractor"
    },
    "activate-selected-text": {
      "description": "Activate Selected Text"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "optional_host_permissions": [
    "<all_urls>"
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "preview/preview.html",
        "preview/preview.js"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
